{
  "name": "sonda-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite build --watch",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run check && vite build",
    "test": "vitest run",
    "format": "prettier --write src vite.config.ts tsconfig.json svelte.config.js package.json index.html .prettierrc.json",
    "format:check": "prettier --check src vite.config.ts tsconfig.json svelte.config.js package.json index.html .prettierrc.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
